<?xml version="1.0" encoding="utf-8"?>
<!--
  JLib::Scheduler, as built inside the umbrella solution.

  Deliberately minimal compared to the standalone project it replaces: x64 only (this library is
  Windows x64 by construction - the context switch is hand-written x64 assembly, so a Win32
  configuration could never have built), C++17 only (the README's compatibility claim, enforced by
  the build rather than asserted), and NO absolute paths.

  Consumers do not name Scheduler.lib or an include directory: they add a ProjectReference to this
  file, and MSBuild works out the build order, the link, and the header dependencies itself. That
  last part is what removes the stale-ABI trap - touching a header here rebuilds every dependent,
  which separate solutions could never do.
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <!-- Optimized + symbols + assertions: the configuration to PLAY in. See JLib.Common.props. -->
    <ProjectConfiguration Include="Development|x64">
      <Configuration>Development</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <VCProjectVersion>18.0</VCProjectVersion>
    <ProjectGuid>{DAB96225-CB15-4F33-B85A-950DB429DF85}</ProjectGuid>
    <RootNamespace>JLibScheduler</RootNamespace>
    <ProjectName>Scheduler</ProjectName>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Development'" Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <!-- MASM: ContextSwitch.asm is the hand-written fiber context switch. Without these two imports
       the .asm is silently ignored and the link fails on the switch symbols. -->
  <ImportGroup Label="ExtensionSettings">
    <Import Project="$(VCTargetsPath)\BuildCustomizations\masm.props" />
  </ImportGroup>
  <ImportGroup Label="PropertySheets">
    <!-- Exactly one of these is ever active. Inside the JLib umbrella the first applies; in the
         standalone JLib-Scheduler repository JLib.Common.props does not exist and the second
         supplies the Development configuration's settings instead. Keeping ONE project file valid
         in both places is what lets the two repositories share sources verbatim. -->
    <Import Project="$(SolutionDir)JLib.Common.props" Condition="exists('$(SolutionDir)JLib.Common.props')" />
    <Import Project="$(MSBuildProjectDirectory)\Scheduler.Standalone.props" Condition="!exists('$(SolutionDir)JLib.Common.props')" />
  </ImportGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <ConformanceMode>true</ConformanceMode>
      <ExceptionHandling>Sync</ExceptionHandling>
      <PreprocessorDefinitions>NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(MSBuildProjectDirectory)\include;$(MSBuildProjectDirectory);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="src\Epochs.cpp" />
    <ClCompile Include="src\Fiber.cpp" />
    <ClCompile Include="src\GlobalFiberPool.cpp" />
    <ClCompile Include="src\Task.cpp" />
    <ClCompile Include="src\TaskDAG.cpp" />
    <ClCompile Include="src\TaskScheduler.cpp" />
    <ClCompile Include="src\Thread.cpp" />
    <!-- Platform-specific sources live in src\win32 and src\posix, split by DIRECTORY rather than
         by filename suffix. That is what lets the CMake build glob src\*.cpp for the shared files
         and add exactly one platform directory, instead of globbing both variants of the same
         translation unit and colliding at link time. This project only ever builds Windows, so it
         names src\win32 and never mentions src\posix. -->
    <ClCompile Include="src\win32\Topology.cpp" />
    <ClCompile Include="src\win32\FiberInit.cpp" />
  </ItemGroup>
  <ItemGroup>
    <MASM Include="src\win32\ContextSwitch.asm" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
    <Import Project="$(VCTargetsPath)\BuildCustomizations\masm.targets" />
  </ImportGroup>
</Project>

